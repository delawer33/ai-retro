# Copy to .env and fill in. The real .env is never committed.
LOG_LEVEL=INFO
# Каталог логов Claude Code (только чтение)
AI_RETRO_LOGS_DIR=~/.claude/projects
# Локальная база; по умолчанию ~/.local/share/ai-retro/ai-retro.db
AI_RETRO_DB_PATH=~/.local/share/ai-retro/ai-retro.db
# Модель классификатора (ADR 0002)
AI_RETRO_MODEL=haiku
# Число потоков при классификации (2-4: лимиты подписки общие)
AI_RETRO_THREADS=3
