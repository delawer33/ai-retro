# Copy to .env and fill in. The real .env is never committed.
LOG_LEVEL=INFO
# Каталог логов Claude Code (только чтение)
AI_RETRO_LOGS_DIR=~/.claude/projects
# Локальная база; по умолчанию ~/.local/share/ai-retro/ai-retro.db
AI_RETRO_DB_PATH=~/.local/share/ai-retro/ai-retro.db
# Модель классификатора (ADR 0002)
AI_RETRO_MODEL=haiku
# Число потоков при классификации (2-4: лимиты подписки общие)
AI_RETRO_THREADS=3
# Максимальная длина ответа агента / брошенной ветки в контексте классификатора, символов
AI_RETRO_CONTEXT_CHARS=2000

# Правила «префикс пути → область» (относительно HOME), через «;».
# Области: работа, личные проекты, учёба, идеи, философия, жизнь, иное.
# Беседы без папки (scratch) область получают от модели по первой реплике.
AI_RETRO_DOMAIN_RULES=work=работа;projects=личные проекты;study=учёба
# Домашний каталог, от которого считаются префиксы (по умолчанию HOME)
# AI_RETRO_HOME=
# Корень глобальных скиллов (<имя>/SKILL.md); скиллы проекта — <проект>/.claude/skills (ADR 0010)
# AI_RETRO_SKILLS_DIR=~/.claude/skills
